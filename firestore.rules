rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Movies collection - users can only access their own movies
    match /movies/{movieId} {
      // Only authenticated users can read their own movies
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Create: must be authenticated, userId must match, all required fields validated
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && isValidMovie(request.resource.data);
      
      // Update: must be authenticated, own movie, valid data, userId cannot change
      allow update: if request.auth != null
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && isValidMovie(request.resource.data);
      
      // Delete: must be authenticated and own the movie
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Fallback for books collection
    match /books/{bookId} {
      allow read, write: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid);
    }
    
    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
  
  function isValidMovie(data) {
    return isValidTitle(data.title)
      && isValidDirector(data.director)
      && isValidGenre(data.genre)
      && isValidStatus(data.status)
      && isValidRating(data)
      && isValidNotes(data);
  }
  
  function isValidTitle(title) {
    return title is string
      && title.matches('.*[^ \\t\\r\\n].*')
      && title.size() <= 100;
  }
  
  function isValidDirector(director) {
    return director is string
      && director.matches('.*[^ \\t\\r\\n].*')
      && director.size() <= 60;
  }
  
  function isValidGenre(genre) {
    return genre in ['Action', 'Comedy', 'Drama', 'Horror'];
  }
  
  function isValidStatus(status) {
    return status in ['Plan to Watch', 'Watching', 'Watched'];
  }
  
  function isValidRating(data) {
    return !('rating' in data)
      || data.rating == null
      || (data.rating is int && data.rating >= 0 && data.rating <= 5);
  }
  
  function isValidNotes(data) {
    return !('notes' in data)
      || data.notes == null
      || (data.notes is string && data.notes.size() <= 300);
  }
}
